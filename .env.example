# Copy this file to `.env` and fill in your own values.
# `.env` itself is gitignored so secrets never reach GitHub.

# Qdrant vector database endpoint.
# Local (Docker):   http://localhost:6333
# Qdrant Cloud:     https://<cluster-id>.<region>.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333

# API key for Qdrant Cloud. Leave blank for a local, unauthenticated instance.
QDRANT_API_KEY=your-qdrant-api-key-here
